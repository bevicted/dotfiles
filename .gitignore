# osx
.DS_Store

# tmux
.config/tmux/plugins

# herdr: logs, sockets and session state live alongside the config
.config/herdr/*
!.config/herdr/config.toml

# opencode: it manages node_modules/package.json itself, and installers drop
# plugins/ and commands/ beside the config. Local provider overrides belong in
# ignored sibling files and can be loaded with OPENCODE_CONFIG.
.config/opencode/*
!.config/opencode/AGENTS.md
!.config/opencode/opencode.jsonc

# pi: local provider/model credentials and state should not be tracked.
.pi/agent/models.json
.pi/agent/settings.json
.pi/agent/auth.json
.pi/agent/extensions/web-fetch/node_modules/

# shell: local helper functions may contain private item paths.
scripts/internal.sh

# nvim
.config/nvim/tt.*
.config/nvim/.tests
.config/nvim/doc/tags
.config/nvim/debug
.config/nvim/.repro
.config/nvim/foo.*
.config/nvim/*.log
.config/nvim/data
.config/nvim/lazy-lock.json

# firefox
.mozilla/firefox/*
!.mozilla/firefox/user.arkenfox/
.mozilla/firefox/user.arkenfox/*
!.mozilla/firefox/user.arkenfox/user-overrides.js
!.mozilla/firefox/user.arkenfox/chrome/
.mozilla/firefox/user.arkenfox/chrome/*
!.mozilla/firefox/user.arkenfox/chrome/userChrome.css

# claude code
.claude/*
!.claude/CLAUDE.md
!.claude/commands/
!.claude/settings.json
!.claude/statusline.sh

# ssh
.ssh/*
!.ssh/config
!.ssh/*.pub
!.ssh/allowed_signers.public

# git
.gitconfig.local

# hypr — per-machine monitor layout (PII: serials, hardware models)
.config/hypr/monitors.conf
.config/hypr/monitors.lua

# work
work.sh

# vanity worker tooling (go.bevicted.dev cloudflare worker)
vanity/node_modules/

# other
/AGENTS.md

