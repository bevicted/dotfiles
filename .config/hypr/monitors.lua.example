-- Machine-specific monitor config. Untracked (real file is gitignored).
--
-- Bootstrap:
--   cp ~/.config/hypr/monitors.lua.example ~/.config/hypr/monitors.lua
--   # edit monitors.lua with the output of: hyprctl monitors
-- hyprland.lua pulls it in via require("monitors"). If monitors.lua is absent,
-- it falls through to the wildcard hl.monitor({ output = "", ... }) default.
--
-- Use `output = "desc:..."` matching so the config survives port swaps and
-- absent monitors on other machines.
--
-- VRR mode: 0 = off, 1 = on, 2 = fullscreen only (safest, no desktop flicker).

-- Primary ultrawide, 165Hz with VRR in fullscreen
